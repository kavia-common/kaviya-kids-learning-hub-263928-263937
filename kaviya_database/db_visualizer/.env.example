# Example environment for db_visualizer
# Copy to .env and adjust as needed. Do not commit real secrets.

# Server
PORT=3000

# MongoDB connection (preferred variable)
MONGODB_URI=mongodb://appuser:dbuser123@localhost:5000/myapp?authSource=admin
# Alternate variable name also supported by server.js
# MONGODB_URL=mongodb://appuser:dbuser123@localhost:5000/?authSource=admin
# Optional explicit DB name (used when MONGODB_URL is provided)
MONGODB_DB=myapp
