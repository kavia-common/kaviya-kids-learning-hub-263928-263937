{
  "name": "simple-db-viewer",
  "version": "1.0.0",
  "description": "Simple database viewer for PostgreSQL, MySQL, SQLite, and MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js --host 0.0.0.0",
    "dev": "nodemon server.js",
    "postinstall": "node -e \"const v=require('express/package.json').version; console.log('[postinstall] express version:', v)\"",
    "NOTE": "This is a helper viewer only. Do NOT wire this into database container startup."
  },
  "dependencies": {
    "express": "4.18.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "object-assign": "4.1.1",
    "pg": "8.11.3",
    "mysql2": "3.6.3",
    "sqlite3": "5.1.6",
    "mongodb": "6.2.0"
  },
  "devDependencies": {
    "nodemon": "3.0.1"
  },
  "engines": {
    "node": ">=16"
  },
  "private": true
}