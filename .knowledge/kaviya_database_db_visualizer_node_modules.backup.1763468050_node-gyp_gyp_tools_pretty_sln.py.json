{"is_source_file": true, "format": "Python", "description": "This script parses Visual Studio solution (.sln) files to extract project information, dependencies, build order, and can generate project view files. It includes functions to parse the solution, print dependency graphs, determine build sequences, and generate project files using an external module `pretty_vcproj`. The script leverages regex to identify project definitions and dependencies and is intended for managing build workflows within a larger software development setup.", "external_files": ["pretty_vcproj"], "external_methods": ["pretty_vcproj.main"], "published": ["BuildProject", "ParseSolution", "PrintDependencies", "PrintBuildOrder", "PrintVCProj", "main"], "classes": [], "methods": [{"name": "BuildProject(project, built, projects, deps)", "description": "Recursively builds a project considering dependencies, printing the build order.", "scope": "", "scopeKind": ""}, {"name": "ParseSolution(solution_file)", "description": "Parses a Visual Studio solution (.sln) file to extract projects and their dependencies.", "scope": "", "scopeKind": ""}, {"name": "PrintDependencies(projects, deps)", "description": "Outputs the list of projects and their dependencies.", "scope": "", "scopeKind": ""}, {"name": "PrintBuildOrder(projects, deps)", "description": "Determines and prints a build order based on dependencies.", "scope": "", "scopeKind": ""}, {"name": "PrintVCProj(projects)", "description": "Generates project files for each project using the `pretty_vcproj` module.", "scope": "", "scopeKind": ""}, {"name": "main()", "description": "Main entry point; runs the script, processes arguments, and invokes parsing and printing functions.", "scope": "", "scopeKind": ""}], "calls": ["BuildProject", "PrintDependencies", "PrintBuildOrder", "pretty_vcproj.main"], "search-terms": ["parse_solution", "visual studio solution", "project dependencies", "build order", "pretty_vcproj", "solution file parser", "sln"], "state": 2, "file_id": 2281, "knowledge_revision": 5356, "git_revision": "c3d304f161b9e5c4d2ab4029c29cb5e9662195c5", "ctags": [{"_type": "tag", "name": "BuildProject", "path": "/home/kavia/workspace/code-generation/kaviya-kids-learning-hub-263928-263937/kaviya_database/db_visualizer/node_modules.backup.1763468050/node-gyp/gyp/tools/pretty_sln.py", "pattern": "/^def BuildProject(project, built, projects, deps):$/", "language": "Python", "kind": "function", "signature": "(project, built, projects, deps)"}, {"_type": "tag", "name": "ParseSolution", "path": "/home/kavia/workspace/code-generation/kaviya-kids-learning-hub-263928-263937/kaviya_database/db_visualizer/node_modules.backup.1763468050/node-gyp/gyp/tools/pretty_sln.py", "pattern": "/^def ParseSolution(solution_file):$/", "language": "Python", "kind": "function", "signature": "(solution_file)"}, {"_type": "tag", "name": "PrintBuildOrder", "path": "/home/kavia/workspace/code-generation/kaviya-kids-learning-hub-263928-263937/kaviya_database/db_visualizer/node_modules.backup.1763468050/node-gyp/gyp/tools/pretty_sln.py", "pattern": "/^def PrintBuildOrder(projects, deps):$/", "language": "Python", "kind": "function", "signature": "(projects, deps)"}, {"_type": "tag", "name": "PrintDependencies", "path": "/home/kavia/workspace/code-generation/kaviya-kids-learning-hub-263928-263937/kaviya_database/db_visualizer/node_modules.backup.1763468050/node-gyp/gyp/tools/pretty_sln.py", "pattern": "/^def PrintDependencies(projects, deps):$/", "language": "Python", "kind": "function", "signature": "(projects, deps)"}, {"_type": "tag", "name": "PrintVCProj", "path": "/home/kavia/workspace/code-generation/kaviya-kids-learning-hub-263928-263937/kaviya_database/db_visualizer/node_modules.backup.1763468050/node-gyp/gyp/tools/pretty_sln.py", "pattern": "/^def PrintVCProj(projects):$/", "language": "Python", "kind": "function", "signature": "(projects)"}, {"_type": "tag", "name": "__author__", "path": "/home/kavia/workspace/code-generation/kavi